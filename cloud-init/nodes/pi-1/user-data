#cloud-config
# pi-1 — k3s server (cluster-init)
# Secrets: __TAILSCALE_AUTH_KEY__, __K3S_TOKEN__ substituted by setup-nfs-roots.sh

hostname: pi-1
manage_etc_hosts: true
locale: en_US.UTF-8
timezone: America/New_York

ssh_pwauth: false

users:
- name: pi
  sudo: ALL=(ALL) NOPASSWD:ALL
  groups: users,adm,dialout,audio,netdev,video,plugdev,cdrom,games,input,gpio,spi,i2c,render,sudo
  shell: /usr/bin/zsh
  ssh_authorized_keys:
  - ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIEG7XnSQNFrUqic84c61/SBe6xOGr5xd++bTAwVFewUj joeblack@MbA.local
  ssh_import_id:
  - 'gh:joeblackwaslike'

packages:
- vim
- zsh
- git
- jq
- nfs-common
- open-iscsi
- parted
- lvm2
package_update: true
package_reboot_if_required: false

write_files:

# k3s server config — pi-1 bootstraps the cluster
- path: /etc/rancher/k3s/config.yaml
  permissions: "0600"
  content: |
    cluster-init: true
    tls-san:
    - 192.168.1.149
    - pi-1
    token: __K3S_TOKEN__
    disable:
    - servicelb
    - traefik
    data-dir: /var/lib/rancher/k3s
    node-label:
    - node.kubernetes.io/instance-type=pi-5
    node-taint:
    - node-role.kubernetes.io/control-plane=:PreferNoSchedule
    kubelet-arg:
    - "root-dir=/var/lib/rancher/k3s/kubelet"
    etcd-arg:
    - auto-compaction-mode=periodic
    - auto-compaction-retention=1h
    - quota-backend-bytes=4294967296
    etcd-expose-metrics: true
    kube-apiserver-arg:
    - event-ttl=1h

# Compaction frees pages but never shrinks the db file; a full file hits the quota and crash-loops k3s
- path: /usr/local/bin/etcd-defrag
  permissions: "0755"
  content: |
    #!/bin/sh
    set -eu
    T=/var/lib/rancher/k3s/server/tls/etcd
    exec /usr/local/bin/etcdctl --command-timeout=600s --endpoints=https://127.0.0.1:2379 \
      --cacert="$T/server-ca.crt" --cert="$T/server-client.crt" --key="$T/server-client.key" defrag

- path: /etc/systemd/system/etcd-defrag.service
  permissions: "0644"
  content: |
    [Unit]
    Description=Defragment the k3s embedded etcd
    After=k3s.service

    [Service]
    Type=oneshot
    ExecStart=/usr/local/bin/etcd-defrag
    NoNewPrivileges=yes
    PrivateTmp=yes
    ProtectHome=yes
    ProtectSystem=strict

- path: /etc/systemd/system/etcd-defrag.timer
  permissions: "0644"
  content: |
    [Unit]
    Description=Weekly etcd defrag

    [Timer]
    OnCalendar=Sun *-*-* 04:00:00
    Persistent=true

    [Install]
    WantedBy=timers.target

# NVMe p2 (ext4, 63.5G) used for k3s data; p3 (LVM) left for Longhorn
- path: /etc/systemd/system/var-lib-rancher.mount
  permissions: "0644"
  content: |
    [Unit]
    Description=Mount NVMe p2 for k3s data
    Before=k3s.service
    After=local-fs.target

    [Mount]
    What=/dev/nvme0n1p2
    Where=/var/lib/rancher
    Type=ext4
    Options=defaults,noatime

    [Install]
    WantedBy=multi-user.target

- path: /etc/sysctl.d/99-k3s.conf
  permissions: "0644"
  content: |
    net.ipv4.ip_forward = 1
    net.bridge.bridge-nf-call-iptables = 1
    net.bridge.bridge-nf-call-ip6tables = 1
    vm.overcommit_memory = 1
    kernel.panic = 10
    kernel.panic_on_oops = 1
    fs.inotify.max_user_instances = 512
    fs.inotify.max_user_watches = 524288

runcmd:
# Partition NVMe only if not already done
- |
  if ! lsblk /dev/nvme0n1p2 &>/dev/null; then
    parted --script /dev/nvme0n1 mklabel gpt
    parted --script /dev/nvme0n1 mkpart primary fat32  1MiB    513MiB
    parted --script /dev/nvme0n1 mkpart primary ext4   513MiB  64513MiB
    parted --script /dev/nvme0n1 mkpart primary        64513MiB 100%
    parted --script /dev/nvme0n1 set 1 esp on
    partprobe /dev/nvme0n1
    sleep 2
    mkfs.vfat -F 32 -n system-boot /dev/nvme0n1p1
    mkfs.ext4 -L writable /dev/nvme0n1p2
    pvcreate /dev/nvme0n1p3
  fi
- systemctl daemon-reload
- systemctl enable --now var-lib-rancher.mount
- sysctl -p /etc/sysctl.d/99-k3s.conf
- curl -fsSL https://tailscale.com/install.sh | sh
- tailscale up --authkey=__TAILSCALE_AUTH_KEY__ --hostname=pi-1
- curl -sfL https://get.k3s.io | sh -
- |
  (
    set -eu
    d=$(mktemp -d)
    curl -fsSL -o "$d/etcd.tgz" https://github.com/etcd-io/etcd/releases/download/v3.6.7/etcd-v3.6.7-linux-arm64.tar.gz
    echo "ef5fc443cf7cc5b82738f3c28363704896551900af90a6d622cae740b5644270  $d/etcd.tgz" | sha256sum -c -
    tar -xzf "$d/etcd.tgz" -C /usr/local/bin --strip-components=1 etcd-v3.6.7-linux-arm64/etcdctl
    rm -rf "$d"
  )
- systemctl enable --now etcd-defrag.timer
