#!/usr/bin/env bash
# Installs the New Relic infrastructure agent on a host outside the cluster (the PXE server)
# and forwards its service logs from journald. Safe to re-run.
#
# Usage: scripts/newrelic-infra-install [host]    (default: PXE_SERVER_IP)
# Needs NEW_RELIC_LICENSE_KEY in the environment (make exports .env) and SSH access as pi.
set -euo pipefail

HOST=${1:-${PXE_SERVER_IP:-}}
[ -n "$HOST" ] || { echo "ERROR: pass a host or set PXE_SERVER_IP" >&2; exit 1; }
[[ ${NEW_RELIC_LICENSE_KEY:-} =~ ^[A-Za-z0-9]{36}NRAL$ ]] ||
	{ echo "ERROR: NEW_RELIC_LICENSE_KEY must be the 40 character key ending in NRAL" >&2; exit 1; }

SSH=(ssh -i "$HOME/.ssh/pi-cluster" -o BatchMode=yes -o IdentitiesOnly=yes "pi@$HOST")

"${SSH[@]}" 'sudo bash -s' <<'REMOTE'
set -euo pipefail
if ! dpkg-query -W -f='${Status}' newrelic-infra 2>/dev/null | grep -q 'install ok installed'; then
	curl -fsSL https://download.newrelic.com/infrastructure_agent/gpg/newrelic-infra.gpg </dev/null |
		gpg --dearmor --yes -o /usr/share/keyrings/newrelic-infra.gpg
	# New Relic publishes no repo for Ubuntu 25.10; the noble (24.04) arm64 package runs on it.
	echo "deb [signed-by=/usr/share/keyrings/newrelic-infra.gpg] https://download.newrelic.com/infrastructure_agent/linux/apt noble main" \
		>/etc/apt/sources.list.d/newrelic-infra.list
	apt-get update
	DEBIAN_FRONTEND=noninteractive apt-get install -y -o Dpkg::Options::=--force-confold newrelic-infra </dev/null
fi
install -d /etc/newrelic-infra/logging.d
cat >/etc/newrelic-infra/logging.d/pxe.yml <<'LOGS'
logs:
  - name: pxe-dnsmasq
    systemd: dnsmasq
  - name: pxe-tftpd
    systemd: tftpd-hpa
  - name: pxe-nfs-mountd
    systemd: nfs-mountd
  - name: pxe-tailscaled
    systemd: tailscaled
  - name: pxe-chrony
    systemd: chrony
  - name: pxe-docker
    systemd: docker
LOGS
REMOTE

printf 'license_key: %s\ndisplay_name: pi-pxe\nlog:\n  level: info\ncustom_attributes:\n  role: pxe-server\n' \
	"$NEW_RELIC_LICENSE_KEY" | "${SSH[@]}" "sudo sh -c 'umask 077 && cat >/etc/newrelic-infra.yml && chmod 600 /etc/newrelic-infra.yml'"

"${SSH[@]}" 'sudo systemctl enable newrelic-infra && sudo systemctl restart newrelic-infra'
for _ in 1 2 3 4 5; do
	sleep 3
	"${SSH[@]}" 'systemctl is-active --quiet newrelic-infra' && { echo "newrelic-infra active on $HOST"; exit 0; }
done
echo "ERROR: newrelic-infra is not active on $HOST; check journalctl -u newrelic-infra" >&2
exit 1
