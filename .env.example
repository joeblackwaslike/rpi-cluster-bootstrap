# Copy to .env and fill in values — never commit .env
TAILSCALE_AUTH_KEY=tskey-auth-...
K3S_TOKEN=your-random-token-here
PXE_SERVER_IP=192.168.1.75
# ntfy.sh topic for Alertmanager alerts: any long random string, for example the output of openssl rand -hex 8
NTFY_TOPIC=
# PagerDuty Events API v2 integration key (32 characters), then `make pagerduty-secret`
PAGERDUTY_ROUTING_KEY=
# New Relic US-region license key (40 characters ending in NRAL; the manifest sets region US), then `make newrelic-secret`
NEW_RELIC_LICENSE_KEY=
# Grafana admin password, stored in the monitoring/grafana-admin Secret (1Password: "Grafana admin - joeblack-homelab"). Use openssl rand -base64 30 output; make mangles $ and #
GRAFANA_ADMIN_PASSWORD=
